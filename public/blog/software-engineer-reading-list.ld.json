        {
          "@type": "Question",
          "name": "Are non-technical books worth reading for engineers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Lakshay Goyal's shelf is mostly non-technical, and the ideas on focus, planning and questioning assumptions apply to daily engineering work. Pair them with a technical classic for balance."
          }
        },
        {
          "@type": "Question",
          "name": "Which book is best for planning work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The 12 Week Year. Lakshay says its idea of treating every 12 weeks like a full year stops procrastination. It is simple, and it works."
          }
        },
        {
          "@type": "Question",
          "name": "Which book helps most with questioning assumptions?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Freedom from the Known by J Krishnamurti. It argues that your thoughts are second-hand and asks you to look at life fresh, which helps when you review inherited code or habits."
          }
        }
      ]
    },
