        {
          "@type": "Question",
          "name": "Should I build mobile or web first?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Start where your users already are, and design mobile-first either way. A responsive web app is often the fastest way to test an idea, since it needs no store review. Add a native or cross-platform app once the core flow works."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need to know both frontend and backend?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You do not need to master both, but knowing the basics of each helps a lot. Engineers who understand the full stack debug faster, make better trade-offs and communicate well with designers and teammates."
          }
        }
      ]
