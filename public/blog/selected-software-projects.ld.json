      "name": "How to evaluate a software engineer's projects",
      "url": "https://lakshaygoyal.in/blog/selected-software-projects",
      "inLanguage": "en",
      "image": {
        "@id": "https://lakshaygoyal.in/blog/selected-software-projects#image-1"
      },
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "Read the problem first and confirm it is specific."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "Check that stack choices have reasons, not just names."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "Look for at least one admitted trade-off."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "Ask whether the result is measurable or at least observable."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "text": "Look for a demo or screenshots that prove it ran."
        }
      ]
    },
